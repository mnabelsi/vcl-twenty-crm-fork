{
  "name": "zoho-crm-sync",
  "version": "0.1.0",
  "description": "Two-way sync of Zoho CRM Contacts and Accounts with Twenty People and Companies",
  "private": true,
  "license": "UNLICENSED",
  "author": "VCL Solutions",
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2",
    "twenty": ">=2.48.0"
  },
  "keywords": [
    "twenty-app",
    "zoho",
    "crm",
    "sync"
  ],
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
